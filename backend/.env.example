# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# HTTPS-ссылка на фронтенд (ссылка из localtunnel: https://....loca.lt)
# Для сброса кэша Telegram добавьте ?v=5 к ссылке после обновления сайта
WEBAPP_URL=https://your-username.github.io/calorie-app/?v=5

# Необязательно: если без VPN бот не видит Telegram (ошибка api.telegram.org)
# Примеры: socks5://127.0.0.1:10808  или  http://127.0.0.1:7890
# PROXY_URL=

# ИИ-ассистент (если Groq блокирует signup — Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_API_KEY=   # AI_PROVIDER=groq + ключ с console.groq.com

# Публичный HTTPS-адрес API (VPS + nginx, Fly.io или cloudflared на порт 8080)
# PUBLIC_API_URL=https://bot.ваш-домен.ru
# PUBLIC_API_URL=https://calorie-bot.fly.dev

# Порт HTTP API (на Fly.io обычно 8080)
# PORT=8080
# AI_RATE_LIMIT_PER_HOUR=30
