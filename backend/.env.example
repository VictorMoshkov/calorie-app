# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# HTTPS-ссылка на фронтенд (ссылка из localtunnel: https://....loca.lt)
WEBAPP_URL=https://your-tunnel-url.loca.lt

# Необязательно: если без VPN бот не видит Telegram (ошибка api.telegram.org)
# Примеры: socks5://127.0.0.1:10808  или  http://127.0.0.1:7890
# PROXY_URL=
